{
    "name": "@skyforce/discord-hybrid-sharding",
    "version": "3.1.0",
    "description": "Maintained and hardened fork of discord-hybrid-sharding: combines cluster manager & internal sharding with distributed resilience, BigInt IPC, and Node 20/22+ optimizations.",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "lint": "eslint src/**/**.ts",
        "lint:fix": "eslint src/**/**.ts --fix",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "generate-docs": "jsdoc -c ./.jsdoc.conf.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/SkyForceDev/discord-hybrid-sharding.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "discord",
        "discord-sharding",
        "discord-clustering",
        "hybrid-sharding",
        "sharding",
        "discord.js-hybrid-sharding",
        "discord.js",
        "eris",
        "discordeno.js",
        "bot",
        "bots",
        "cluster",
        "framework",
        "skyforce"
    ],
    "author": "SkyForce (https://github.com/SkyForceDev)",
    "contributors": [
        "meister03"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/SkyForceDev/discord-hybrid-sharding/issues"
    },
    "homepage": "https://github.com/SkyForceDev/discord-hybrid-sharding#readme",
    "peerDependencies": {
        "discord.js": "^14.0.0 || ^15.0.0-dev"
    },
    "peerDependenciesMeta": {
        "discord.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/jest": "^29.5.12",
        "@types/node": "^20.12.2",
        "@typescript-eslint/eslint-plugin": "^7.5.0",
        "@typescript-eslint/parser": "^7.5.0",
        "clean-jsdoc-theme": "^4.2.18",
        "discord.js": "^14.22.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-jsdoc": "^48.2.2",
        "eslint-plugin-prettier": "^5.1.3",
        "jest": "^29.7.0",
        "jsdoc": "^4.0.2",
        "prettier": "^3.2.5",
        "ts-jest": "^29.1.2",
        "typescript": "^5.4.3"
    }
}